<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- FileProvider for secure APK installation via content:// URIs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM: the chatz-push Worker sends data-only messages here so the app
             itself decides whether to post, even when the process was started
             by the system rather than opened by the user. -->
        <service
            android:name=".data.push.ChatzPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

    <!-- Required: Internet access for Firebase Auth and Cloud Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required: Check connectivity type (Wi-Fi vs mobile data) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required: Read Wi-Fi connection state -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Required: Show push notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required: Read real screen time. Without this declaration Android never
         lists ChatZ under Settings → Special app access → Usage access, which is
         what makes the toggle appear greyed out and un-tappable. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Required: Allow WorkManager to restart after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Required: Android's own "don't optimize this app" dialog, which is the
         first step of the battery-optimization exemption flow. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Required: Android 8+ permission to install APKs from unknown sources -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only needed on Android 6-7 for mobile data stats -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="25" />

    <!-- Android 11+ package visibility: without these, resolveActivity() and
         explicit intents cannot see the OEM security/battery settings apps
         (MIUI, ColorOS, Funtouch, EMUI, XOS, One UI). -->
    <queries>
        <!-- Android 11+ package visibility: keeps every settings screen ChatZ
             deep-links to visible to resolve/query calls, and makes the
             Transsion system-Settings component reachable by explicit intent. -->
        <intent><action android:name="android.settings.USAGE_ACCESS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.APP_NOTIFICATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS" /></intent>
        <intent><action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" /></intent>
        <intent><action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DATA_USAGE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.APPBOOTSERB" /></intent>
        <package android:name="com.android.settings" />

        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.abeui" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.transsion.phonemaster" />
        <package android:name="com.transsion.phonemanager" />
        <package android:name="com.mediatek.autobootcontroller" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm_cn" />
    </queries>
</manifest>
